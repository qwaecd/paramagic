#version 430 core
#define BINDING_PARTICLE_DATA 1
#define BINDING_BUCKET_COUNTERS 7

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct Particle {
    vec4 meta;        // x: effectId, y: primitiveType bits, z: facingMode bits, w: materialSlot bits
    vec4 position;
    vec4 velocity;
    vec4 attributes;
    vec4 renderAttribs;
    vec4 color;
};

layout(std430, binding = BINDING_PARTICLE_DATA) buffer ParticleData {
    Particle particles[];
};

layout(std430, binding = BINDING_BUCKET_COUNTERS) buffer BucketCounters {
    uint bucketCounts[];
};

uniform int u_maxParticles;
uniform int u_maxTexturedMaterials;

uint resolveBucket(Particle p) {
    uint materialSlot = floatBitsToUint(p.meta.w);
    if (materialSlot != 0u && materialSlot <= uint(u_maxTexturedMaterials)) {
        // Textured particles are always quads. Bucket 0..2 are the additive primitive buckets.
        return 3u + materialSlot - 1u;
    }
    return min(floatBitsToUint(p.meta.y), 2u);
}

void main() {
    uint particleIndex = gl_GlobalInvocationID.x;
    if (particleIndex >= uint(u_maxParticles)) {
        return;
    }

    Particle particle = particles[particleIndex];
    if (particle.attributes.x >= particle.attributes.y) {
        return;
    }

    atomicAdd(bucketCounts[resolveBucket(particle)], 1u);
}
